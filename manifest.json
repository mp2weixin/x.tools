{
    "name":"X.Tools工具箱",
    "version": "1.0.0",
    "manifest_version": 3,
    "homepage_url": "https://hobbyconnect.cn",
    "description": "X.tools浏览器脚本运行容器,脚本工具箱市场;通过开发者模式可以在线直接调试工具脚本,完成发布、安装、执行流程...",
    "icons": {
        "24": "icons/icon_24.png",
		"48": "icons/icon_48.png",
		"64": "icons/icon_64.png"
    },
    "permissions": [
		"scripting", 
		"activeTab",
		"alarms", 
		"cookies", 
		"contextMenus",
		"tabs", 
		"downloads",
		"offscreen",
		"storage",
		"sidePanel",
		"declarativeNetRequest",
    	"declarativeNetRequestWithHostAccess"
	],
	"host_permissions": [
		"<all_urls>"
	],
  	"action": {
		"default_title": "X.Tools工具箱",
		"default_icon": {
			"24": "icons/icon_24.png",
			"48": "icons/icon_48.png",
			"64": "icons/icon_64.png"
		}
	},
	"side_panel": {
		"default_path": "template/index.html"
	},
    "background": {
		"service_worker": "static/bg_script.min.js"
	},
    "content_scripts": [{
		"matches": [
            "http://*/*",
            "https://*/*"
        ],
		"js": [
			"s/html2pdf.min.js",
			"s/jquery-3.1.0.min.js",
			"static/wd_script.min.js",
			"static/ct_script.min.js"
		],
		"css": [],
		"run_at": "document_start",
		"all_frames": true,
        "world": "ISOLATED"
	}],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
	},
	"web_accessible_resources": [{
		"resources": ["manifest.json", "icons/*", "s/*", "s/ffmpeg/*", "s/ffmpeg/esm/*", "static/*", "template/*"],
		"matches": ["<all_urls>"]
	}]
}